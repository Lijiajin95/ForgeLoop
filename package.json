{
  "name": "forgeloop-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build --workspace forgeloop-dsh",
    "typecheck": "npm run typecheck --workspace forgeloop-dsh",
    "test": "npm run test --workspace forgeloop-dsh",
    "check": "npm run check --workspace forgeloop-dsh",
    "lint": "eslint packages/forgeloop/src packages/forgeloop/tests scripts/ts",
    "format:check": "prettier --check \"packages/forgeloop/{src,tests}/**/*.ts\" \"scripts/ts/**/*.ts\"",
    "check:repo": "node scripts/ts/check-repo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "glob": "^10.5.0",
    "tinypool": "^2.2.0"
  }
}
