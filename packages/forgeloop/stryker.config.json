{
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.fast.config.ts" },
  "mutate": ["src/domain/retry-policy.ts", "src/domain/admission.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation.json" },
  "thresholds": { "high": 95, "low": 85, "break": 80 },
  "concurrency": 2,
  "timeoutMS": 60000
}
