{
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/**/*.ts"
  ],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/mutation-incremental.json",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 80
  },
  "concurrency": 2,
  "timeoutMS": 60000
}
