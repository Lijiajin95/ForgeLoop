# ForgeLoop 常驻服务（固定启动器托管）systemd user unit 模板。
#
# 首次接入（维护窗口，允许重启；不需要 sudo）：
#   scripts/install_local_service.sh --no-enable
#   # 审阅脚本将写入的 unit / owner.json / 目录权限后：
#   systemctl --user daemon-reload
#   systemctl --user enable --now forgeloop
#
# 普通业务版本升级**不要**执行 systemctl restart / daemon-reload，也不改写本 unit：
#   forgeloop upgrade apply --prefix %h/.local/share/forgeloop \
#     --tag vX.Y.Z --by <身份> --reason <理由>
# 固定启动器（独立 venv）保持运行，替换业务子进程并处理失败恢复。
#
# 查看状态与日志：
#   systemctl --user status forgeloop
#   journalctl --user -u forgeloop -f
#   forgeloop upgrade status --prefix %h/.local/share/forgeloop
#
# 边界（如实声明）：
# - 启动器自身升级是低频维护操作（scripts/install_local_service.sh --refresh-launcher），
#   不属于普通升级。
# - 普通升级不访问 systemd 总线；本 unit 只在首次接入/维护时重载。
# - 回退失败会进入 recovery_required 并停止自动推进，等待人工核对。
# - 非回环监听由程序本身拒绝；部署批准、发布回执与产物 SHA256 由启动器独立核对。

[Unit]
Description=ForgeLoop 常驻服务（固定启动器托管）
Documentation=file:%h/Project/ForgeLoop/docs/deployment.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Project/ForgeLoop
ExecStart=%h/.local/share/forgeloop/launcher/.venv/bin/forgeloop-launcher --prefix %h/.local/share/forgeloop
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
Environment=PYTHONUNBUFFERED=1
# PI 的隔离 HOME：必须含非空的 .pi/agent/models.json，且与 config/service.toml 里项目档案的
# pi_home 一致，否则该项目会被如实跳过（不匹配就不执行）。按本机实际情况修改路径。
Environment=HOME=%h/.local/share/forgeloop/pi-home
# 测试命令是任务包里的快照（本项目为 uv run pytest …）：PATH 必须能找到这些工具。
Environment=PATH=%h/.local/share/forgeloop/launcher/.venv/bin:%h/Project/ForgeLoop/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
