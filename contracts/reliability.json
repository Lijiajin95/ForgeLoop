  "state_machines": [
    {
      "id": "deployment-attempt",
      "title": "部署 attempt 状态机",
      "module": "packages/forgeloop/src/domain/deployment.ts",
      "enforcement": "canTransition 是唯一迁移判定；Deployments.transition 在写库前校验，成功后持久化 state 与 updatedAt。",
      "initial": "draft",
      "states": [
        "draft",
        "preflight_failed",
        "awaiting_approval",
        "rejected",
        "ready",
        "applying",
        "applied_pending_verify",
        "verifying",
        "verified",
        "failed",
        "verify_failed",
        "rolling_back",
        "rolled_back"
      ],
      "terminal": [
        "preflight_failed",
        "rejected",
        "rolled_back"
      ],
      "frozen": [],
      "transition_rule": "explicit",
      "transitions": [
        {
          "from": "draft",
          "to": "preflight_failed",
          "via": "request：门禁或预检失败",
          "tested": true
        },
        {
          "from": "draft",
          "to": "awaiting_approval",
          "via": "request：预检通过且需人工批准",
          "tested": true
        },
        {
          "from": "draft",
          "to": "ready",
          "via": "request：预检通过且自动批准",
          "tested": true
        },
        {
          "from": "awaiting_approval",
          "to": "rejected",
          "via": "reject",
          "tested": true
        },
        {
          "from": "awaiting_approval",
          "to": "ready",
          "via": "approve",
          "tested": true
        },
        {
          "from": "ready",
          "to": "applying",
          "via": "apply",
          "tested": true
        },
        {
          "from": "applying",
          "to": "applied_pending_verify",
          "via": "apply：工具成功",
          "tested": true
        },
        {
          "from": "applying",
          "to": "failed",
          "via": "apply：工具失败/超时/输出畸形",
          "tested": true
        },
        {
          "from": "applied_pending_verify",
          "to": "verifying",
          "via": "verify",
          "tested": true
        },
        {
          "from": "applied_pending_verify",
          "to": "verify_failed",
          "via": "verify：观察失败（当前实现先进入 verifying 再判定）",
          "tested": true
        },
        {
          "from": "applied_pending_verify",
          "to": "rolling_back",
          "via": "回滚入口（域表声明）",
          "tested": true
        },
        {
          "from": "verifying",
          "to": "verified",
          "via": "verify：版本一致",
          "tested": true
        },
        {
          "from": "verifying",
          "to": "verify_failed",
          "via": "verify：工具失败或版本不一致",
          "tested": true
        },
        {
          "from": "verifying",
          "to": "failed",
          "via": "verify：工具调用失败（域表声明）",
          "tested": true
        },
        {
          "from": "verified",
          "to": "rolling_back",
          "via": "回滚入口（域表声明）",
          "tested": true
        },
        {
          "from": "verify_failed",
          "to": "rolling_back",
          "via": "回滚入口（域表声明）",
          "tested": true
        },
        {
          "from": "failed",
          "to": "rolling_back",
          "via": "回滚入口（域表声明）",
          "tested": true
        },
        {
          "from": "rolling_back",
          "to": "rolled_back",
          "via": "回滚结束",
          "tested": true
        },
        {
          "from": "rolling_back",
          "to": "failed",
          "via": "回滚失败",
          "tested": true
        }
      ],
      "runtime_gaps": [
        {
