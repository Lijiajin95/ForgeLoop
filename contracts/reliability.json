  "invariants": [
    {
      "id": "retry-clear-facts",
      "title": "重试只在全部阻塞事实清零时放行",
      "statement": "retryDecision 返回 allowed=true 时，需求处于可重试状态、计划已批准、仍有未交付任务、无在途请求/运行任务/等待人工任务、剩余轮次>0，且阻塞原因不含硬阻塞词。",
      "modules": [
        "domain-retry-policy"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants.test.ts",
        "title": "only allows retry when every blocking fact is clear",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "retry-deterministic",
      "title": "同一事实的重试判定确定且可重复",
      "statement": "对同一组 RetryFacts，retryDecision 的多次调用结果完全一致，不依赖时间、随机数或外部状态。",
      "modules": [
        "domain-retry-policy"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants.test.ts",
        "title": "is deterministic for the same facts",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "retry-rounds-exhausted",
      "title": "失败轮次耗尽后绝不自动放行",
      "statement": "remainingRounds=0 时 retryDecision.allowed 必须为 false，且原因包含追加授权提示；不受其它事实组合影响。",
      "modules": [
        "domain-retry-policy"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "never allows retry once failure rounds are exhausted",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "retry-terminal-lock",
      "title": "终态需求不允许重试",
      "statement": "accepted/rejected/cancelled 状态下 retryDecision.allowed 必须为 false，原因指明终态。",
      "modules": [
        "domain-retry-policy",
        "domain-status"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "never allows retry from a terminal requirement state",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "requirement-version-contiguity",
      "title": "需求版本从 1 起连续且只追加",
      "statement": "validateRequirement 接受任意长度、连续编号、原文非空且绑定项目的版本序列；任何跳号、空原文、空身份都被拒绝。",
      "modules": [
        "domain-requirement"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "keeps requirement versions contiguous and append-only",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "analysis-json-roundtrip",
      "title": "分析载荷 JSON 往返不丢字段、不放宽校验",
      "statement": "对 parseAnalysisDraft 接受且无待澄清项的载荷，JSON.stringify → parseAnalysisDraft 得到完全相同的结构化结果；问题类输入不得携带待澄清项。",
      "modules": [
        "domain-requirement"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "round-trips an analysis payload through JSON",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "plan-task-identity-roundtrip",
      "title": "任务包序列化往返保留 task identity",
      "statement": "对任意合法的任务包草稿，parseTaskPlanDraft 解析后的 taskId 序列与输入一致，task_id 不因序列化、裁剪或重新排序而丢失。",
      "modules": [
        "domain-task-plan"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants.test.ts",
        "title": "round-trips a serialized plan without losing task identity",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "plan-file-path-safety",
      "title": "任务文件清单不得越出项目根",
      "statement": "parseTaskPlanDraft 拒绝绝对路径、`..` 越界段、空文件清单与重复项；连续分隔符按段归一化，任何被接受的文件清单都留在项目根内。",
      "modules": [
        "domain-task-plan"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "keeps task plan file paths inside the project root",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "plan-execution-order",
      "title": "执行顺序是尊重依赖的完整排列",
      "statement": "executionOrder 返回每个任务恰好一次，且任一任务出现在其全部依赖之后；有环时必须抛错而不是返回部分顺序。",
      "modules": [
        "domain-task-plan"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "returns a dependency-respecting execution order",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "plan-limit-aggregation",
      "title": "需求级工时只在全部任务有上限时求和",
      "statement": "planLimitSeconds 对含任一 -1（不限）的任务返回 -1，否则返回各任务限额之和。",
      "modules": [
        "domain-task-plan"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "aggregates plan limits as unlimited or the exact sum",
        "min_runs": 200
      },
      "gates": [
        "property",
        "incremental-mutation"
      ],
      "risk": "P1"
    },
    {
      "id": "deployment-terminal-closure",
      "title": "部署状态机终态无出边",
      "statement": "canTransition 对任何终态（preflight_failed/rejected/rolled_back）作为起点均返回 false；对未声明边返回 false，且判定确定。",
      "modules": [
        "domain-deployment"
      ],
      "tests": [
        "packages/forgeloop/tests/property-invariants-advanced.test.ts"
      ],
      "property_test": {
        "file": "packages/forgeloop/tests/property-invariants-advanced.test.ts",
        "title": "never leaves a terminal deployment state",
        "min_runs": 200
      },
      "gates": [
        "property",
        "state-machine",
        "incremental-mutation"
      ],
      "risk": "P0"
    },
    {
      "id": "deployment-tool-result-bounds",
      "title": "部署工具输出严格解析且有界",
      "statement": "parseDeploymentToolResult 只接受带布尔 ok 与非空 state 的 JSON 对象；detail≤2000、steps≤50、单 step≤300、version≤120；缺失/畸形字段抛 MalformedError，不猜测成功。",
      "modules": [
