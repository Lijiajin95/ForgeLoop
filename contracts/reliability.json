{
  "schema_version": 1,
  "project": "ForgeLoop",
  "description": "ForgeLoop 进阶可靠性清单：核心模块、关键不变量、状态机、P0 场景、稳定性与受控变异范围。只登记比 architecture.json 更细的可靠性语义，不重复分层/依赖规则。修改本文件必须与对应测试同一 PR 显式审阅。",
  "gates": {
    "registry": {
      "command": "node scripts/ts/reliability-registry.ts",
      "description": "校验本清单结构、文件存在、门禁/NA、状态机闭包与变异门槛。"
    },
    "property": {
      "command": "node scripts/ts/reliability-properties.ts",
      "description": "运行登记的全部 fast-check 属性测试，每项至少 200 次，失败打印 seed。"
    },
    "state-machine": {
      "command": "node scripts/ts/reliability-tests.ts state-machine",
      "description": "串行运行状态机测试：合法边、非法边、终态、中断恢复与持久化一致。"
    },
    "scenarios": {
      "command": "node scripts/ts/reliability-tests.ts scenarios",
      "description": "运行登记的 P0 边界与异常场景测试。"
    },
    "stability": {
      "command": "make stability",
      "description": "关键测试串行独立运行 3 次，区分测试失败与环境错误。"
    },
    "incremental-mutation": {
      "command": "node scripts/ts/mutation-incremental.ts",
      "description": "对 git diff 影响的源码及其直接依赖做 Stryker 增量变异；受控范围门槛 80%。"
    },
    "coverage": {
      "command": "make coverage",
      "description": "逐文件覆盖率 行>=90 / 函数>=95 / 分支>=85。"
    },
    "check-static": {
      "command": "make check-static",
      "description": "类型检查、ESLint、架构契约、预算与本清单校验。"
    }
  },
  "modules": [
    {
