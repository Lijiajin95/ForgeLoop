{
  "schema_version": 2,
  "surface": "dsh-plugin",
  "package": "forgeloop-dsh",
  "command": {
    "name": "fl",
    "input": "raw text: <subcommand> [args]",
    "subcommands": [
      {
        "name": "help",
        "effect": "read",
        "arguments": []
      },
      {
        "name": "status",
        "effect": "read",
        "arguments": [
          "[req_id]"
        ],
        "output": {
          "with_req_id": {
            "type": "object",
            "description": "运行时 requirementView；命令结果中的 JSON 正文在既有字段之外稳定包含 failureRoundDetails 与 grantQuota",
            "required": [
              "reqId",
              "status",
              "failureRounds",
              "grants",
              "failureRoundDetails",
              "grantQuota"
            ],
            "properties": {
              "reqId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "failureRounds": {
                "type": "integer",
                "minimum": 0,
                "description": "累计失败轮次数，与 failureRoundDetails.length 一致"
              },
              "grants": {
                "type": "integer",
                "minimum": 1,
                "description": "累计授权次数（含初始授权），与 grantQuota.grants 一致"
              },
              "failureRoundDetails": {
                "type": "array",
                "description": "按 occurredAt 升序排列的失败轮次明细；没有失败轮次时为空数组",
                "items": {
                  "type": "object",
                  "required": [
                    "roundId",
                    "stage",
                    "summary",
                    "occurredAt"
                  ],
                  "properties": {
                    "roundId": {
                      "type": "string"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "formal_test",
                        "user_acceptance"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "occurredAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "grantQuota": {
                "type": "object",
                "description": "当前授权额度；grants 为累计授权次数（含初始授权），used 为已记录失败轮次数，remaining = max(0, grants * 3 - used)",
                "required": [
                  "grants",
                  "used",
                  "remaining"
                ],
                "properties": {
                  "grants": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "used": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "remaining": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          },
          "without_req_id": {
            "type": "object",
            "description": "需求列表输出；不包含 failureRoundDetails 与 grantQuota",
            "required": [
              "requirements"
            ],
            "properties": {
              "requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "reqId",
                    "status",
                    "versions",
                    "title"
                  ],
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "versions": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      {
        "name": "submit",
        "effect": "write-intake",
        "arguments": [
          "<text>"
        ]
      },
      {
        "name": "revise",
        "effect": "write-intake",
        "arguments": [
          "<req_id>",
          "<text>"
        ]
      },
      {
        "name": "analyze",
        "effect": "queue",
        "arguments": [
          "<req_id>",
          "[--wait]"
        ]
      },
      {
        "name": "plan",
        "effect": "queue",
        "arguments": [
          "<req_id>",
          "[--wait]"
        ]
      },
      {
        "name": "advance",
        "effect": "queue",
        "arguments": [
          "<req_id>",
          "[--wait]"
        ]
      },
      {
        "name": "show",
        "effect": "read",
        "arguments": [
          "<req_id>"
        ]
      },
      {
        "name": "impact",
        "effect": "read",
        "arguments": [
          "<req_id>",
          "[--explain]"
        ],
        "output": {
          "type": "object",
          "description": "需求修订影响摘要正文。事实区恒在 sections[0]，由确定性记录计算；未指定 --explain 时 inference 为 null 且 sections 只含事实区，明确说明未请求推断、未调用任何模型。只有显式 --explain 才追加 inference 区，并标记为模型推断、不是确定事实。命令文本首行是摘要，空行后为与本结构一致的 JSON。",
          "required": [
            "kind",
            "reqId",
            "explainRequested",
            "facts",
            "inference",
            "sections",
            "notice"
          ],
          "properties": {
            "kind": {
              "const": "impact-explain"
            },
            "reqId": {
              "type": "string"
            },
            "explainRequested": {
              "type": "boolean",
              "description": "是否显式请求模型推断；false 表示零模型调用"
            },
            "facts": {
              "description": "确定性事实区；只读记录计算，模型输出不能写回",
              "$ref": "#/definitions/impact_facts"
            },
            "inference": {
              "description": "模型推断区；默认 null。非 null 时 provenance=model-inference、inference=true，status 非 completed 时 text 不可采信",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/impact_inference"
                }
              ]
            },
            "sections": {
              "type": "array",
              "description": "展示分区：事实区恒在第一位；仅显式请求推断时追加推断区",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/impact_facts_section"
                  },
                  {
                    "$ref": "#/definitions/impact_inference"
                  }
                ]
              }
            },
            "notice": {
              "type": "string",
              "description": "面向人的显式说明：未请求推断时说明仅含事实且未调用模型；请求推断时说明事实/推断分区及推断不可作为决定依据"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "plan-show",
        "effect": "read",
        "arguments": [
          "<req_id>",
          "[plan_version]"
        ]
      },
      {
        "name": "approve",
        "effect": "human-decision",
        "arguments": [
          "<req_id>",
          "<plan_version>"
        ]
      },
      {
        "name": "grant",
        "effect": "human-decision",
        "arguments": [
          "<req_id>"
        ]
      },
      {
        "name": "accept",
        "effect": "human-decision",
        "arguments": [
          "<req_id>",
          "[artifact_sha256]"
        ]
      },
      {
        "name": "candidate",
        "effect": "build",
        "arguments": [
          "<req_id>",
          "[x.y.z]"
        ]
      },
      {
        "name": "evidence",
        "effect": "read",
        "arguments": [
          "<req_id>"
        ]
      },
      {
        "name": "requests",
        "effect": "read",
        "arguments": [
          "[req_id]"
        ]
      },
      {
        "name": "recover",
        "effect": "human-decision",
        "arguments": [
          "<req_id>",
          "[confirm]"
        ]
      },
      {
        "name": "stop",
        "effect": "human-decision",
        "arguments": [
          "<req_id>",
          "<reason>"
        ]
      },
      {
        "name": "cancel",
        "effect": "human-decision",
        "arguments": [
          "<req_id>",
          "<reason>"
        ]
      },
      {
        "name": "config",
        "effect": "read",
        "arguments": []
      }
    ]
  },
  "tools": [
    {
      "name": "forgeloop_status",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_show_requirement",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_show_plan",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_evidence",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_requests",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_impact",
      "effect": "read",
      "trust": "model"
    },
    {
      "name": "forgeloop_submit_requirement",
      "effect": "write-intake",
      "trust": "model"
    }
  ],
  "definitions": {
    "impact_reason": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定的判定代码，例如 analysis_requirement_stale、task_not_delivered、request_result_unknown"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "impact_check": {
      "type": "object",
      "description": "每条事实统一的过期/待核对判定；stale 与 pending 可同时成立，state=stale_pending",
      "required": [
        "state",
        "stale",
        "pending",
        "staleReasons",
        "pendingReasons",
        "reasons"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "pending",
            "stale_pending"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "pending": {
          "type": "boolean"
        },
        "staleReasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/impact_reason"
          }
        },
        "pendingReasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/impact_reason"
          }
        },
        "reasons": {
          "type": "array",
          "description": "staleReasons 与 pendingReasons 的合并",
          "items": {
            "$ref": "#/definitions/impact_reason"
          }
        }
      }
    },
    "impact_material": {
      "type": "object",
      "description": "交付材料摘要；任一摘要缺失时对应交付标为待核对",
      "required": [
        "candidateSha256",
        "testEvidenceSha256",
        "reviewSha256",
        "baselineCommit",
        "authorizationSource",
        "acceptance",
        "recordedAt"
      ],
      "properties": {
        "candidateSha256": {
          "type": "string"
        },
        "testEvidenceSha256": {
          "type": "string"
        },
        "reviewSha256": {
          "type": "string"
        },
        "baselineCommit": {
          "type": "string"
        },
        "authorizationSource": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "impact_requirement_version": {
      "type": "object",
      "required": [
        "version",
        "createdAt",
        "revisedBy",
        "source",
        "latest"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revisedBy": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "latest": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "impact_analysis": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "analysisVersion",
            "requirementVersion",
            "createdAt",
            "goal",
            "latest"
          ],
          "properties": {
            "analysisVersion": {
              "type": "integer",
              "minimum": 1
            },
            "requirementVersion": {
              "type": "integer",
              "minimum": 1,
              "description": "该分析依据的需求版本"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "goal": {
              "type": "string"
            },
            "latest": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "impact_task": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "taskId",
            "goal",
            "dependsOn",
            "delivered",
            "material"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "delivered": {
              "type": "boolean"
            },
            "material": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/impact_material"
                }
              ]
            }
          }
        }
      ]
    },
    "impact_plan": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "planVersion",
            "taskPlanId",
            "requirementVersion",
            "createdAt",
            "latest",
            "tasks"
          ],
          "properties": {
            "planVersion": {
              "type": "integer",
              "minimum": 1
            },
            "taskPlanId": {
              "type": "string"
            },
            "requirementVersion": {
              "type": "integer",
              "minimum": 1,
              "description": "该任务包依据的需求版本"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "latest": {
              "type": "boolean"
            },
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_task"
              }
            }
          }
        }
      ]
    },
    "impact_approval": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "planVersion",
            "requirementId",
            "requirementVersion",
            "approvedBy",
            "approvedAt",
            "source",
            "current"
          ],
          "properties": {
            "planVersion": {
              "type": "integer",
              "minimum": 1
            },
            "requirementId": {
              "type": "string"
            },
            "requirementVersion": {
              "description": "由批准绑定的任务包派生；任务包缺失时为 null",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvedBy": {
              "type": "string"
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "type": "string"
            },
            "current": {
              "type": "boolean",
              "description": "是否为当前最新批准绑定"
            }
          }
        }
      ]
    },
    "impact_delivery": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "planVersion",
            "taskId",
            "goal",
            "material",
            "deliveredAt"
          ],
          "properties": {
            "planVersion": {
              "type": "integer",
              "minimum": 1
            },
            "taskId": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "material": {
              "$ref": "#/definitions/impact_material"
            },
            "deliveredAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "impact_request": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "requestId",
            "action",
            "requestState",
            "planVersion",
            "createdAt"
          ],
          "properties": {
            "requestId": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "requestState": {
              "type": "string",
              "description": "持久请求自身状态（pending/claimed/done/failed/unknown/dismissed），与 ImpactCheck.state 的过期/待核对判定分开"
            },
            "planVersion": {
              "type": "integer",
              "minimum": 0
            },
            "createdAt": {
              "type": "string"
            }
          }
        }
      ]
    },
    "impact_coverage": {
      "type": "object",
      "required": [
        "analyzed",
        "planned",
        "approved",
        "fullyDelivered"
      ],
      "properties": {
        "analyzed": {
          "type": "boolean"
        },
        "planned": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "fullyDelivered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "impact_summary": {
      "type": "object",
      "required": [
        "requirementVersions",
        "analyses",
        "plans",
        "approvals",
        "deliveredTasks",
        "requests",
        "gaps",
        "staleItems",
        "pendingItems"
      ],
      "properties": {
        "requirementVersions": {
          "type": "integer",
          "minimum": 0
        },
        "analyses": {
          "type": "integer",
          "minimum": 0
        },
        "plans": {
          "type": "integer",
          "minimum": 0
        },
        "approvals": {
          "type": "integer",
          "minimum": 0
        },
        "deliveredTasks": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "staleItems": {
          "type": "integer",
          "minimum": 0
        },
        "pendingItems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "impact_facts": {
      "allOf": [
        {
          "$ref": "#/definitions/impact_check"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "reqId",
            "project",
            "status",
            "latestRequirementVersion",
            "requirementVersions",
            "latestAnalysisVersion",
            "latestPlanVersion",
            "currentApprovalPlanVersion",
            "analyses",
            "plans",
            "approvals",
            "currentApproval",
            "deliveries",
            "requests",
            "coverage",
            "summary"
          ],
          "properties": {
            "kind": {
              "const": "facts"
            },
            "reqId": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "latestRequirementVersion": {
              "type": "integer",
              "minimum": 1
            },
            "requirementVersions": {
              "type": "array",
              "description": "需求全部版本，含版本号、时间、修订来源；latest=true 的是最新版本",
              "items": {
                "$ref": "#/definitions/impact_requirement_version"
              }
            },
            "latestAnalysisVersion": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "latestPlanVersion": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "currentApprovalPlanVersion": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "analyses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_analysis"
              }
            },
            "plans": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_plan"
              }
            },
            "approvals": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_approval"
              }
            },
            "currentApproval": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/impact_approval"
                }
              ]
            },
            "deliveries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_delivery"
              }
            },
            "requests": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/impact_request"
              }
            },
            "coverage": {
              "$ref": "#/definitions/impact_coverage"
            },
            "summary": {
              "$ref": "#/definitions/impact_summary"
            }
          }
        }
      ]
    },
    "impact_facts_section": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "provenance",
        "facts"
      ],
      "properties": {
        "kind": {
          "const": "facts"
        },
        "title": {
          "const": "确定性事实"
        },
        "provenance": {
          "const": "deterministic"
        },
        "facts": {
          "$ref": "#/definitions/impact_facts"
        }
      },
      "additionalProperties": false
    },
    "impact_inference": {
      "type": "object",
      "description": "模型推断区；始终与事实区分离，不得作为批准、推进或验收依据",
      "required": [
        "kind",
        "title",
        "provenance",
        "inference",
        "label",
        "status",
        "text",
        "reason",
        "sessionId",
        "toolCalls",
        "disclaimer"
      ],
      "properties": {
        "kind": {
          "const": "inference"
        },
        "title": {
          "const": "模型推断（推断）"
        },
        "provenance": {
          "const": "model-inference"
        },
        "inference": {
          "const": true
        },
