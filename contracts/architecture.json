{
  "schema_version": 3,
  "runtime": {
    "package": "packages/forgeloop"
  },
  "layers": [
    {
      "name": "config",
      "path": "packages/forgeloop/src/config.ts",
      "may_import": [
        "domain"
      ]
    },
    {
      "name": "domain",
      "path": "packages/forgeloop/src/domain",
      "may_import": []
    },
    {
      "name": "agents",
      "path": "packages/forgeloop/src/agents",
      "may_import": [
        "domain"
      ]
    },
    {
      "name": "records",
      "path": "packages/forgeloop/src/records",
      "may_import": [
        "domain"
      ]
    },
    {
      "name": "runtime",
      "path": "packages/forgeloop/src/runtime",
      "may_import": [
        "domain",
        "records",
        "config"
      ]
    },
    {
      "name": "entry",
      "path": "packages/forgeloop/src",
      "may_import": [
        "domain",
        "records",
        "runtime",
        "config"
      ]
    }
  ],
  "persistence": {
    "engine": "sqlite",
    "driver": "node:sqlite",
    "database": "<recordsRoot>/projects/<project>/records.sqlite"
  },
  "model_surface": {
    "prefix": "forgeloop_"
  },
  "ui_surface": {
    "slot": "conversation.view",
    "view_id": "forgeloop",
    "order": 20,
    "data_path": "/api/forgeloop/board"
  },
  "retired_paths": [
    "legacy",
    "src/forgeloop",
    "frontend",
    "scripts/install_local_service.sh"
  ],
  "session_surface": {
    "preset_id": "forgeloop",
    "interception": "agent/pre-step"
  }
}
