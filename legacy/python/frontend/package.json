{
  "name": "forgeloop-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ForgeLoop 状态页前端：TypeScript 源、ESLint 结构与边界规则、Vitest 覆盖、Playwright 真实浏览器与 Stryker 变异",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "format": "prettier --write . ../src/forgeloop/cli/web_page.html",
    "format:check": "prettier --check . ../src/forgeloop/cli/web_page.html",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "depcruise": "depcruise src tests --config .dependency-cruiser.cjs",
    "knip": "knip",
    "e2e": "playwright test",
    "mutation": "stryker run",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
